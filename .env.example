# Groq: generation (qwen/qwen3.8-27b) and judging (openai/gpt-oss-120b).
# Comma-separate several keys to pool free-tier quotas: key1,key2,key3
GROQ_API_KEYS=
GROQ_API_KEY=

# Google AI Studio: embeddings only (gemini-embedding-001 at 768 dims).
GOOGLE_API_KEY=

# Pinecone: serverless, 768 dims, cosine.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=meridian-policies

# Optional overrides. Changing a model mid-study invalidates the comparison.
# GENERATOR_MODEL=qwen/qwen3.8-27b
# JUDGE_MODEL=openai/gpt-oss-120b
# CROSS_JUDGE_MODEL=openai/gpt-oss-20b

# Optional Langfuse Cloud tracing and experiments. Leave the keys empty offline.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
